{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cyrograf Markdown",
  "scopeName": "markdown.cyrograf.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#fenced-cyrograf" }
  ],
  "repository": {
    "fenced-cyrograf": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(cyrograf)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.fence.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\s*)(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.fence.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.cyrograf",
      "patterns": [
        { "include": "source.cyrograf" }
      ]
    }
  }
}